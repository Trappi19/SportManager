<Application x:Class="SportManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Palette FM violet / or -->
            <SolidColorBrush x:Key="BackgroundBrush"    Color="#0E0826"/>
            <SolidColorBrush x:Key="CardBrush"          Color="#1C1248"/>
            <SolidColorBrush x:Key="CardAltBrush"       Color="#150D35"/>
            <SolidColorBrush x:Key="AccentBrush"        Color="#F5A623"/>
            <SolidColorBrush x:Key="AccentHoverBrush"   Color="#E07B00"/>
            <SolidColorBrush x:Key="DangerBrush"        Color="#C0392B"/>
            <SolidColorBrush x:Key="DangerHoverBrush"   Color="#A93226"/>
            <SolidColorBrush x:Key="SuccessBrush"       Color="#251660"/>
            <SolidColorBrush x:Key="SuccessHoverBrush"  Color="#3A2090"/>
            <SolidColorBrush x:Key="TextBrush"          Color="#FFFFFF"/>
            <SolidColorBrush x:Key="MutedBrush"         Color="#7060A8"/>
            <SolidColorBrush x:Key="SeparatorBrush"     Color="#2A1C5E"/>
            <SolidColorBrush x:Key="InputBrush"         Color="#150D35"/>
            <SolidColorBrush x:Key="InputBorderBrush"   Color="#2A1C5E"/>

            <!-- Bouton de base -->
            <Style x:Key="BtnBase" TargetType="Button">
                <Setter Property="Foreground"        Value="White"/>
                <Setter Property="Padding"           Value="18,9"/>
                <Setter Property="BorderThickness"   Value="0"/>
                <Setter Property="Cursor"            Value="Hand"/>
                <Setter Property="FontSize"          Value="13"/>
                <Setter Property="FontWeight"        Value="SemiBold"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root" Background="{TemplateBinding Background}"
                                    CornerRadius="5" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Root" Property="Opacity" Value="0.8"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Root" Property="Opacity" Value="0.35"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Or : action principale (Ajouter) -->
            <Style x:Key="BtnSuccess" TargetType="Button" BasedOn="{StaticResource BtnBase}">
                <Setter Property="Background"  Value="#F5A623"/>
                <Setter Property="Foreground"  Value="#1C1248"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#E07B00"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Violet : action secondaire (Modifier, Enregistrer) -->
            <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource BtnBase}">
                <Setter Property="Background"  Value="#251660"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#3A2090"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Rouge : Supprimer -->
            <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource BtnBase}">
                <Setter Property="Background"  Value="#C0392B"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#A93226"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Discret : Actualiser, Retour -->
            <Style x:Key="BtnSecondary" TargetType="Button" BasedOn="{StaticResource BtnBase}">
                <Setter Property="Background"  Value="#1C1248"/>
                <Setter Property="Foreground"  Value="#7060A8"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#251660"/>
                        <Setter Property="Foreground" Value="White"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- TextBox -->
            <Style x:Key="ModernTextBox" TargetType="TextBox">
                <Setter Property="Background"       Value="#150D35"/>
                <Setter Property="Foreground"       Value="White"/>
                <Setter Property="BorderBrush"      Value="#2A1C5E"/>
                <Setter Property="BorderThickness"  Value="1"/>
                <Setter Property="Padding"          Value="10,7"/>
                <Setter Property="FontSize"         Value="13"/>
                <Setter Property="CaretBrush"       Value="White"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="5">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter Property="BorderBrush" Value="#F5A623"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ComboBox avec popup sombre -->
            <Style x:Key="ModernComboBox" TargetType="ComboBox">
                <Setter Property="Background"      Value="#150D35"/>
                <Setter Property="Foreground"      Value="White"/>
                <Setter Property="BorderBrush"     Value="#2A1C5E"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize"        Value="13"/>
                <Setter Property="MaxDropDownHeight" Value="200"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <!-- Zone cliquable -->
                                <Border x:Name="Root"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="32"/>
                                        </Grid.ColumnDefinitions>
                                        <ContentPresenter Grid.Column="0"
                                                          Margin="10,7,0,7"
                                                          Content="{TemplateBinding SelectionBoxItem}"
                                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                          VerticalAlignment="Center"
                                                          TextBlock.Foreground="White"
                                                          IsHitTestVisible="False"/>
                                        <Path Grid.Column="1"
                                              Data="M 0 0 L 5 5 L 10 0 Z"
                                              Fill="#F5A623" Width="10" Height="5"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"/>
                                        <!-- Bouton transparent pour ouvrir -->
                                        <ToggleButton Grid.ColumnSpan="2"
                                                      Background="Transparent"
                                                      BorderThickness="0"
                                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                                  RelativeSource={RelativeSource TemplatedParent}}"
                                                      Focusable="False"/>
                                    </Grid>
                                </Border>
                                <!-- Popup -->
                                <Popup x:Name="PART_Popup"
                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                       Placement="Bottom"
                                       AllowsTransparency="True"
                                       Focusable="False">
                                    <Border Background="#1C1248"
                                            BorderBrush="#2A1C5E"
                                            BorderThickness="1"
                                            CornerRadius="0,0,5,5"
                                            MinWidth="{Binding ActualWidth,
                                                       RelativeSource={RelativeSource TemplatedParent}}">
                                        <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                                      VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="BorderBrush" Value="#F5A623"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Padding"    Value="10,8"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ComboBoxItem">
                                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter TextBlock.Foreground="{TemplateBinding Foreground}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="#251660"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="#F5A623"/>
                                                <Setter Property="Foreground" Value="#1C1248"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Label formulaire -->
            <Style x:Key="FormLabel" TargetType="TextBlock">
                <Setter Property="Foreground"  Value="#7060A8"/>
                <Setter Property="FontSize"    Value="11"/>
                <Setter Property="FontWeight"  Value="Bold"/>
                <Setter Property="Margin"      Value="0,0,0,5"/>
            </Style>

            <!-- DataGrid -->
            <Style TargetType="DataGrid">
                <Setter Property="Background"               Value="#1C1248"/>
                <Setter Property="Foreground"               Value="White"/>
                <Setter Property="BorderThickness"          Value="0"/>
                <Setter Property="GridLinesVisibility"      Value="Horizontal"/>
                <Setter Property="HorizontalGridLinesBrush" Value="#2A1C5E"/>
                <Setter Property="RowBackground"            Value="#150D35"/>
                <Setter Property="AlternatingRowBackground" Value="#1C1248"/>
                <Setter Property="SelectionMode"            Value="Single"/>
                <Setter Property="AutoGenerateColumns"      Value="False"/>
                <Setter Property="CanUserAddRows"           Value="False"/>
                <Setter Property="CanUserDeleteRows"        Value="False"/>
                <Setter Property="IsReadOnly"               Value="True"/>
                <Setter Property="HeadersVisibility"        Value="Column"/>
                <Setter Property="RowHeaderWidth"           Value="0"/>
            </Style>

            <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background"       Value="#0E0826"/>
                <Setter Property="Foreground"       Value="#F5A623"/>
                <Setter Property="Padding"          Value="10,8"/>
                <Setter Property="FontWeight"       Value="Bold"/>
                <Setter Property="FontSize"         Value="12"/>
                <Setter Property="BorderBrush"      Value="#2A1C5E"/>
                <Setter Property="BorderThickness"  Value="0,0,0,2"/>
            </Style>

            <Style TargetType="DataGridCell">
                <Setter Property="Padding"         Value="10,6"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground"      Value="White"/>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background"  Value="#251660"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="DataGridRow">
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#251660"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#1C1248"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- TabItem -->
            <Style TargetType="TabItem">
                <Setter Property="Foreground"        Value="#7060A8"/>
                <Setter Property="Background"        Value="#1C1248"/>
                <Setter Property="BorderThickness"   Value="0"/>
                <Setter Property="Padding"           Value="16,8"/>
                <Setter Property="FontSize"          Value="13"/>
                <Setter Property="FontWeight"        Value="SemiBold"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}"
                                    BorderThickness="0,0,0,3"
                                    BorderBrush="Transparent">
                                <ContentPresenter ContentSource="Header"
                                                  TextBlock.Foreground="{TemplateBinding Foreground}"
                                                  TextBlock.FontWeight="{TemplateBinding FontWeight}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Root" Property="Background"    Value="#251660"/>
                                    <Setter TargetName="Root" Property="BorderBrush"   Value="#F5A623"/>
                                    <Setter Property="Foreground"                      Value="White"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="#1E1450"/>
                                    <Setter Property="Foreground"                   Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Slider -->
            <Style x:Key="ModernSlider" TargetType="Slider">
                <Setter Property="Minimum"             Value="0"/>
                <Setter Property="Maximum"             Value="10"/>
                <Setter Property="TickFrequency"       Value="1"/>
                <Setter Property="IsSnapToTickEnabled" Value="True"/>
                <Setter Property="Foreground"          Value="#F5A623"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
