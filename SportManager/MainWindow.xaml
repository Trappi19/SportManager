<Window x:Class="SportManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quidditch Manager 2025"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#150D35">

    <Window.Resources>
        <!-- Bouton menu style FM : icône + titre + sous-titre, stripe or au hover -->
        <Style x:Key="MenuBtn" TargetType="Button">
            <Setter Property="Background"             Value="Transparent"/>
            <Setter Property="Foreground"             Value="White"/>
            <Setter Property="BorderThickness"        Value="0"/>
            <Setter Property="Height"                 Value="72"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor"                 Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}">
                            <Grid>
                                <!-- Stripe or sur le bord gauche -->
                                <Border x:Name="Stripe" Width="5"
                                        HorizontalAlignment="Left"
                                        Background="#F5A623" Opacity="0"/>
                                <ContentPresenter Margin="28,0,16,0"
                                                  VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root"   Property="Background" Value="#251660"/>
                                <Setter TargetName="Stripe" Property="Opacity"    Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#3A2090"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Séparateur léger -->
        <Style x:Key="Sep" TargetType="Border">
            <Setter Property="Height"     Value="1"/>
            <Setter Property="Background" Value="#2A1C5E"/>
        </Style>

        <!-- Mini-carte panneau droit -->
        <Style x:Key="MiniCard" TargetType="Border">
            <Setter Property="Background"   Value="#1C1045"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding"      Value="14,10"/>
            <Setter Property="Margin"       Value="0,0,0,6"/>
            <Setter Property="Cursor"       Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════════════════════
             PANNEAU GAUCHE  (violet foncé, style FM)
             ═══════════════════════════════════════════ -->
        <Grid Grid.Column="0" Background="#1C1248">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- En-tête logo -->
                <RowDefinition Height="*"/>     <!-- Menu -->
            </Grid.RowDefinitions>

            <!-- ── En-tête logo ── -->
            <Border Grid.Row="0" Background="#0E0826" Padding="22,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="QUIDDITCH"
                                   FontSize="28" FontWeight="Black" Foreground="White"/>
                        <TextBlock Text="MANAGER"
                                   FontSize="28" FontWeight="Black" Foreground="White"/>
                        <TextBlock Text="2025"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="#F5A623" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Badge QM style FM dB -->
                    <Border Grid.Column="1" Width="62" Height="62"
                            CornerRadius="5" VerticalAlignment="Top">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#F5A623" Offset="0"/>
                                <GradientStop Color="#E07B00" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="QM" FontSize="22" FontWeight="Black"
                                       Foreground="#1C1248" HorizontalAlignment="Center"/>
                            <TextBlock Text="dB" FontSize="10" FontWeight="Bold"
                                       Foreground="#1C1248" HorizontalAlignment="Center"
                                       Margin="0,-2,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ── Menu ── -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center">

                <Border Style="{StaticResource Sep}"/>

                <Button Style="{StaticResource MenuBtn}" Click="OpenJoueurs_Click">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="JOUEURS" FontSize="15" FontWeight="Bold"/>
                            <TextBlock Text="Gérer les joueurs et leurs compétences"
                                       FontSize="11" Foreground="#7060A8" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <Border Style="{StaticResource Sep}"/>

                <Button Style="{StaticResource MenuBtn}" Click="OpenEquipes_Click">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ÉQUIPES" FontSize="15" FontWeight="Bold"/>
                            <TextBlock Text="Composer et gérer vos équipes"
                                       FontSize="11" Foreground="#7060A8" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <Border Style="{StaticResource Sep}"/>

                <Button Style="{StaticResource MenuBtn}" Click="OpenMatch_Click">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="MATCHS" FontSize="15" FontWeight="Bold"/>
                            <TextBlock Text="Simuler et consulter l'historique"
                                       FontSize="11" Foreground="#7060A8" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <Border Style="{StaticResource Sep}"/>

                <Button Style="{StaticResource MenuBtn}" Click="Quitter_Click">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="QUITTER" FontSize="15" FontWeight="Bold"/>
                        <TextBlock Text="Fermer l'application"
                                   FontSize="11" Foreground="#7060A8" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>

                <Border Style="{StaticResource Sep}"/>

            </StackPanel>

        </Grid>

        <!-- ═══════════════════════════════════════════
             PANNEAU DROIT  (atmosphérique, sombre)
             ═══════════════════════════════════════════ -->
        <Grid Grid.Column="1">

            <!-- Accueil : image + stats (masqué quand une section est ouverte) -->
            <Grid x:Name="PanelAccueil">
            <!-- Image de fond : stade de Quidditch (chargée en code-behind) -->
            <Image x:Name="ImgFond" Stretch="UniformToFill"/>

            <!-- Badge version haut-droite (style "DOWNLOAD NOW") -->
            <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,28,28,0" CornerRadius="4">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#F5A623" Offset="0"/>
                        <GradientStop Color="#E07B00" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <TextBlock Text="QUIDDITCH MANAGER" Foreground="#1C1248"
                           FontWeight="Black" FontSize="12"
                           Padding="14,8"/>
            </Border>


            <!-- Stats bas-droite -->
            <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Right"
                        Margin="0,0,28,28" Width="220">

                <Border Style="{StaticResource MiniCard}">
                    <DockPanel>
                        <TextBlock Text="JOUEURS" DockPanel.Dock="Left"
                                   Foreground="#7060A8" FontSize="11" FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatJoueurs" Text="—"
                                   Foreground="White" FontSize="13" FontWeight="Bold"
                                   HorizontalAlignment="Right"/>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource MiniCard}">
                    <DockPanel>
                        <TextBlock Text="ÉQUIPES" DockPanel.Dock="Left"
                                   Foreground="#7060A8" FontSize="11" FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatEquipes" Text="—"
                                   Foreground="White" FontSize="13" FontWeight="Bold"
                                   HorizontalAlignment="Right"/>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource MiniCard}">
                    <DockPanel>
                        <TextBlock Text="MATCHS" DockPanel.Dock="Left"
                                   Foreground="#7060A8" FontSize="11" FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatMatchs" Text="—"
                                   Foreground="White" FontSize="13" FontWeight="Bold"
                                   HorizontalAlignment="Right"/>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource MiniCard}">
                    <StackPanel>
                        <TextBlock Text="DERNIER MATCH"
                                   Foreground="#7060A8" FontSize="11" FontWeight="Bold"
                                   Margin="0,0,0,4"/>
                        <TextBlock x:Name="TbLastMatch"
                                   Text="Aucun match joué" Foreground="#5040A0"
                                   FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

            </StackPanel>
            </Grid><!-- fin PanelAccueil -->

            <!-- Section inline (Joueurs / Équipes / Matchs) -->
            <ContentControl x:Name="PanelContenu"
                            Background="{StaticResource BackgroundBrush}"
                            Visibility="Collapsed"/>

        </Grid>
    </Grid>
</Window>
