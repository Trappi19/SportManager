<UserControl x:Class="SportManager.Views.Windows.EquipesWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>    <!-- Header -->
            <RowDefinition Height="2*"/>    <!-- DataGrid équipes : 2/3 de l'espace dispo -->
            <RowDefinition Height="*"/>     <!-- Composition : 1/3 de l'espace dispo -->
            <RowDefinition Height="60"/>    <!-- Footer boutons -->
        </Grid.RowDefinitions>

        <!-- ── HEADER ── -->
        <Border Grid.Row="0" Grid.Column="0"
                Background="#0E0826"
                BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,0,1">
            <TextBlock Text="Gestion des Équipes"
                       FontSize="20" FontWeight="Bold" Foreground="White"
                       VerticalAlignment="Center" Margin="20,0"/>
        </Border>

        <!-- ── DATAGRID équipes ── -->
        <!-- Double-clic sur une ligne → ouvre directement le formulaire de modification -->
        <DataGrid Grid.Row="1" Grid.Column="0" x:Name="GridEquipes" Margin="16,16,16,0"
                  SelectionChanged="GridEquipes_SelectionChanged"
                  MouseDoubleClick="GridEquipes_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"        Binding="{Binding Id}"            Width="55"/>
                <DataGridTextColumn Header="Nom"       Binding="{Binding Nom}"           Width="*"/>
                <DataGridTextColumn Header="Score /10" Binding="{Binding ScoreGeneral}"  Width="80"/>
                <DataGridTextColumn Header="Joueurs"   Binding="{Binding JoueursDisplay}" Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ── COMPOSITION équipe sélectionnée ── -->
        <Border Grid.Row="2" Grid.Column="0"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,1,0,0"
                Margin="16,0">
            <Grid Margin="16,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="COMPOSITION DE L'ÉQUIPE SÉLECTIONNÉE"
                           Style="{StaticResource FormLabel}" Margin="0,0,0,8"/>
                <DataGrid Grid.Row="1" x:Name="GridCompo"
                          Background="Transparent" RowBackground="Transparent"
                          AlternatingRowBackground="#150D35">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nom"     Binding="{Binding Nom}"            Width="*"/>
                        <DataGridTextColumn Header="Poste"   Binding="{Binding Affectation}"    Width="130"/>
                        <DataGridTextColumn Header="Général" Binding="{Binding ScoreGeneral}"   Width="75"/>
                        <DataGridTextColumn Header="Blessure" Binding="{Binding BlessureDisplay}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- ── FOOTER ── -->
        <Border Grid.Row="3" Grid.Column="0"
                Background="#0E0826"
                BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <Button Content="Ajouter"     Style="{StaticResource BtnSuccess}"
                        Margin="6,0" Click="Ajouter_Click"/>
                <Button x:Name="BtnModifier"  Content="Modifier" Style="{StaticResource BtnPrimary}"
                        Margin="6,0" Click="Modifier_Click" IsEnabled="False"/>
                <Button x:Name="BtnSupprimer" Content="Supprimer" Style="{StaticResource BtnDanger}"
                        Margin="6,0" Click="Supprimer_Click" IsEnabled="False"/>
                <Button Content="Actualiser"  Style="{StaticResource BtnSecondary}"
                        Margin="20,0,6,0" Click="Actualiser_Click"/>
                <Button Content="Retour"      Style="{StaticResource BtnSecondary}"
                        Margin="6,0" Click="Retour_Click"/>
            </StackPanel>
        </Border>

        <!-- ── PANNEAU FORM équipe (droite) ── -->
        <Border Grid.Column="1" Grid.Row="0" Grid.RowSpan="4"
                x:Name="FormPanel" Width="320" Visibility="Collapsed"
                Background="#1C1248"
                BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24">

                    <!-- Titre + bouton de fermeture (×) sur la même ligne -->
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="×"
                                FontSize="16" FontWeight="Bold"
                                Background="Transparent" BorderThickness="0"
                                Foreground="#7060A8" Cursor="Hand"
                                Padding="4,0"
                                Click="AnnulerForm_Click"/>
                        <TextBlock x:Name="TbFormTitle" Text="NOUVELLE ÉQUIPE"
                                   FontSize="14" FontWeight="Black" Foreground="White"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                    <Border Height="1" Background="{StaticResource SeparatorBrush}" Margin="0,0,0,20"/>

                    <TextBlock Text="NOM DE L'ÉQUIPE" Style="{StaticResource FormLabel}"/>
                    <TextBox x:Name="TbNom" Style="{StaticResource ModernTextBox}" Margin="0,0,0,20"/>

                    <Border Background="#150D35" CornerRadius="5" Padding="10,7" Margin="0,0,0,16">
                        <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11"
                                   Text="3 Poursuiveurs · 2 Batteurs · 1 Gardien · 1 Attrapeur"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <TextBlock Text="POURSUIVEURS (×3)" Style="{StaticResource FormLabel}"/>
                    <ComboBox x:Name="CbP1" Style="{StaticResource ModernComboBox}"
                              DisplayMemberPath="DisplayLabel" Margin="0,0,0,8"/>
                    <ComboBox x:Name="CbP2" Style="{StaticResource ModernComboBox}"
                              DisplayMemberPath="DisplayLabel" Margin="0,0,0,8"/>
                    <ComboBox x:Name="CbP3" Style="{StaticResource ModernComboBox}"
                              DisplayMemberPath="DisplayLabel" Margin="0,0,0,16"/>

                    <TextBlock Text="BATTEURS (×2)" Style="{StaticResource FormLabel}"/>
                    <ComboBox x:Name="CbB1" Style="{StaticResource ModernComboBox}"
                              DisplayMemberPath="DisplayLabel" Margin="0,0,0,8"/>
                    <ComboBox x:Name="CbB2" Style="{StaticResource ModernComboBox}"
                              DisplayMemberPath="DisplayLabel" Margin="0,0,0,16"/>

                    <TextBlock Text="GARDIEN (×1)" Style="{StaticResource FormLabel}"/>
                    <ComboBox x:Name="CbG" Style="{StaticResource ModernComboBox}"
                              DisplayMemberPath="DisplayLabel" Margin="0,0,0,16"/>

                    <TextBlock Text="ATTRAPEUR (×1)" Style="{StaticResource FormLabel}"/>
                    <ComboBox x:Name="CbA" Style="{StaticResource ModernComboBox}"
                              DisplayMemberPath="DisplayLabel" Margin="0,0,0,20"/>

                    <Button Content="Enregistrer" Style="{StaticResource BtnSuccess}"
                            Click="Enregistrer_Click" Margin="0,0,0,8"/>
                    <Button Content="Annuler" Style="{StaticResource BtnSecondary}"
                            Click="AnnulerForm_Click"/>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
