<UserControl x:Class="SportManager.Views.Windows.JoueursWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">

    <!--
        Layout 3 lignes × 2 colonnes :
        Col 0 (*) = contenu principal  |  Col 1 (Auto) = panneau formulaire rétractable
        Row 0 (64px) = header          |  Row 1 (*) = DataGrid
        Row 2 (60px) = footer boutons
    -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <!-- ── HEADER : titre + barre de recherche (DockPanel aligne la SearchBox à droite) ── -->
        <Border Grid.Row="0" Grid.Column="0"
                Background="#0E0826"
                BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,0,1">
            <DockPanel Margin="20,0" VerticalAlignment="Center">
                <TextBlock Text="Gestion des Joueurs"
                           FontSize="20" FontWeight="Bold" Foreground="White"
                           VerticalAlignment="Center"/>
                <!-- SearchBox : filtre le DataGrid en temps réel via SearchBox_TextChanged -->
                <TextBox x:Name="SearchBox" Width="220"
                         Style="{StaticResource ModernTextBox}"
                         DockPanel.Dock="Right" VerticalAlignment="Center"
                         TextChanged="SearchBox_TextChanged"/>
            </DockPanel>
        </Border>

        <!-- ── DATAGRID : liste de tous les joueurs (source = JoueursWindow._all ou sous-liste filtrée) ── -->
        <!-- Double-clic sur une ligne → ouvre directement le formulaire de modification -->
        <DataGrid Grid.Row="1" Grid.Column="0" x:Name="Grid" Margin="16"
                  SelectionChanged="Grid_SelectionChanged"
                  MouseDoubleClick="Grid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"       Binding="{Binding Id}"              Width="50"/>
                <DataGridTextColumn Header="Nom"      Binding="{Binding Nom}"             Width="*"/>
                <DataGridTextColumn Header="Défense"   Binding="{Binding ScoreDefense}"   Width="65"/>
                <DataGridTextColumn Header="Attaque"   Binding="{Binding ScoreAttaque}"   Width="65"/>
                <DataGridTextColumn Header="Vitesse"   Binding="{Binding ScoreVitesse}"   Width="65"/>
                <DataGridTextColumn Header="Endurance" Binding="{Binding ScoreEndurance}" Width="75"/>
                <DataGridTextColumn Header="Général"   Binding="{Binding ScoreGeneral}"   Width="65"/>
                <DataGridTextColumn Header="Buts"      Binding="{Binding ButsMarques}"    Width="50"/>
                <DataGridTextColumn Header="Poste"     Binding="{Binding Affectation}"    Width="110"/>
                <DataGridTextColumn Header="Blessure"  Binding="{Binding BlessureDisplay}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ── FOOTER ── -->
        <Border Grid.Row="2" Grid.Column="0"
                Background="#0E0826"
                BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <Button Content="Ajouter"    Style="{StaticResource BtnSuccess}"
                        Margin="6,0" Click="Ajouter_Click"/>
                <Button x:Name="BtnModifier" Content="Modifier" Style="{StaticResource BtnPrimary}"
                        Margin="6,0" Click="Modifier_Click" IsEnabled="False"/>
                <Button x:Name="BtnSupprimer" Content="Supprimer" Style="{StaticResource BtnDanger}"
                        Margin="6,0" Click="Supprimer_Click" IsEnabled="False"/>
                <Button Content="Actualiser" Style="{StaticResource BtnSecondary}"
                        Margin="20,0,6,0" Click="Actualiser_Click"/>
                <Button Content="Retour"     Style="{StaticResource BtnSecondary}"
                        Margin="6,0" Click="Retour_Click"/>
            </StackPanel>
        </Border>

        <!-- ── PANNEAU FORM (Col 1, s'étend sur les 3 lignes, masqué par défaut) ──
             Visibility géré en code-behind : Visible = création/modification, Collapsed = repos -->
        <Border Grid.Column="1" Grid.Row="0" Grid.RowSpan="3"
                x:Name="FormPanel" Width="300" Visibility="Collapsed"
                Background="#1C1248"
                BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24">

                    <!-- Titre + bouton de fermeture (×) sur la même ligne -->
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="×"
                                FontSize="16" FontWeight="Bold"
                                Background="Transparent" BorderThickness="0"
                                Foreground="#7060A8" Cursor="Hand"
                                Padding="4,0"
                                Click="AnnulerForm_Click"/>
                        <TextBlock x:Name="TbFormTitle" Text="NOUVEAU JOUEUR"
                                   FontSize="14" FontWeight="Black" Foreground="White"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                    <Border Height="1" Background="{StaticResource SeparatorBrush}" Margin="0,0,0,20"/>

                    <TextBlock Text="NOM DU JOUEUR" Style="{StaticResource FormLabel}"/>
                    <TextBox x:Name="TbNom" Style="{StaticResource ModernTextBox}" Margin="0,0,0,16"/>

                    <TextBlock Text="POSTE" Style="{StaticResource FormLabel}"/>
                    <!-- Changement de poste → recalcule le badge d'exigences via CbPoste_Changed -->
                    <ComboBox x:Name="CbPoste" Style="{StaticResource ModernComboBox}" Margin="0,0,0,6"
                              SelectionChanged="CbPoste_Changed">
                        <ComboBoxItem Content="Poursuiveur"/>
                        <ComboBoxItem Content="Batteur"/>
                        <ComboBoxItem Content="Gardien"/>
                        <ComboBoxItem Content="Attrapeur"/>
                    </ComboBox>
                    <!-- Badge d'exigences : texte vert si stats OK, rouge sinon (coloré en code-behind) -->
                    <Border Background="#150D35" CornerRadius="4" Padding="10,7" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="EXIGENCES DU POSTE"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="10" FontWeight="Bold" Margin="0,0,0,3"/>
                            <TextBlock x:Name="TbExigences" Text="—"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="DÉFENSE (0-100)" Style="{StaticResource FormLabel}"/>
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock x:Name="LblDef" Text="0" DockPanel.Dock="Right" Width="34"
                                   Foreground="{StaticResource AccentBrush}" FontWeight="Bold"
                                   VerticalAlignment="Center" TextAlignment="Right"/>
                        <Slider x:Name="SlDef" Style="{StaticResource ModernSlider}"
                                Maximum="100" ValueChanged="Score_Changed"/>
                    </DockPanel>

                    <TextBlock Text="ATTAQUE (0-100)" Style="{StaticResource FormLabel}"/>
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock x:Name="LblAtt" Text="0" DockPanel.Dock="Right" Width="34"
                                   Foreground="{StaticResource AccentBrush}" FontWeight="Bold"
                                   VerticalAlignment="Center" TextAlignment="Right"/>
                        <Slider x:Name="SlAtt" Style="{StaticResource ModernSlider}"
                                Maximum="100" ValueChanged="Score_Changed"/>
                    </DockPanel>

                    <TextBlock Text="VITESSE (0-100)" Style="{StaticResource FormLabel}"/>
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock x:Name="LblVitesse" Text="0" DockPanel.Dock="Right" Width="34"
                                   Foreground="{StaticResource AccentBrush}" FontWeight="Bold"
                                   VerticalAlignment="Center" TextAlignment="Right"/>
                        <Slider x:Name="SlVitesse" Style="{StaticResource ModernSlider}"
                                Maximum="100" ValueChanged="Score_Changed"/>
                    </DockPanel>

                    <TextBlock Text="ENDURANCE (0-100)" Style="{StaticResource FormLabel}"/>
                    <DockPanel Margin="0,0,0,16">
                        <TextBlock x:Name="LblEndurance" Text="0" DockPanel.Dock="Right" Width="34"
                                   Foreground="{StaticResource AccentBrush}" FontWeight="Bold"
                                   VerticalAlignment="Center" TextAlignment="Right"/>
                        <Slider x:Name="SlEndurance" Style="{StaticResource ModernSlider}"
                                Maximum="100" ValueChanged="Score_Changed"/>
                    </DockPanel>

                    <Border Background="#150D35" CornerRadius="5" Padding="12,8" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Score général : "
                                       Foreground="{StaticResource MutedBrush}" FontSize="13"/>
                            <TextBlock x:Name="LblGen" Text="0 / 100"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontWeight="Bold" FontSize="13"/>
                        </StackPanel>
                    </Border>

                    <!-- Section buts : visible uniquement en mode modification (masquée à la création) -->
                    <StackPanel x:Name="PanelButs" Visibility="Collapsed" Margin="0,0,0,24">
                        <Border Height="1" Background="{StaticResource SeparatorBrush}" Margin="0,0,0,12"/>
                        <TextBlock Text="BUTS MARQUES" Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="TbButs" Style="{StaticResource ModernTextBox}"
                                 Margin="0,0,0,4"/>
                    </StackPanel>

                    <Button Content="Enregistrer" Style="{StaticResource BtnSuccess}"
                            Click="Enregistrer_Click" Margin="0,0,0,8"/>
                    <Button Content="Annuler" Style="{StaticResource BtnSecondary}"
                            Click="AnnulerForm_Click"/>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
