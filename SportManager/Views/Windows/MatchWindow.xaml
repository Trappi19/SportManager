<UserControl x:Class="SportManager.Views.Windows.MatchWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:SportManager"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>
        <!-- Tableau statique des notes possible — utilisé comme ItemsSource de la ComboBox d'évaluation -->
        <x:Array x:Key="Notes" Type="sys:String">
            <sys:String>Excellent</sys:String>
            <sys:String>Bon</sys:String>
            <sys:String>Insuffisant</sys:String>
        </x:Array>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Background="#0E0826"
                BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,0,1">
            <TextBlock Text="Matchs"
                       FontSize="20" FontWeight="Bold" Foreground="White"
                       VerticalAlignment="Center" Margin="20,0"/>
        </Border>

        <!-- CONTENU -->
        <TabControl Grid.Row="1" Background="Transparent"
                    BorderBrush="{StaticResource SeparatorBrush}"
                    Foreground="{StaticResource TextBrush}">

            <!-- ══════════════ ONGLET MATCH ══════════════ -->
            <TabItem Header="  Gestion du Match  " Foreground="{StaticResource TextBrush}"
                     Background="{StaticResource CardBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">

                        <!-- Sélection équipes -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Équipe 1 -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="ÉQUIPE 1" Style="{StaticResource FormLabel}"/>
                                <ComboBox x:Name="CbEq1" Style="{StaticResource ModernComboBox}"
                                          DisplayMemberPath="Nom"
                                          SelectionChanged="Equipe_SelectionChanged"/>
                                <Border x:Name="PanelEq1" Background="{StaticResource CardBrush}"
                                        CornerRadius="6" Margin="0,10,0,0" Padding="12"
                                        Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock x:Name="TbEq1Score"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   FontWeight="Bold" FontSize="13" Margin="0,0,0,6"/>
                                        <DataGrid x:Name="GridEq1" MaxHeight="140"
                                                  Background="Transparent" RowBackground="Transparent"
                                                  AlternatingRowBackground="#1A2332">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Nom"   Binding="{Binding Nom}"          Width="*"/>
                                                <DataGridTextColumn Header="Poste" Binding="{Binding Affectation}"  Width="110"/>
                                                <DataGridTextColumn Header="Score" Binding="{Binding ScoreGeneral}" Width="60"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- VS -->
                            <TextBlock Grid.Column="1" Text="VS"
                                       FontSize="28" FontWeight="Black"
                                       Foreground="{StaticResource DangerBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            <!-- Équipe 2 -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="ÉQUIPE 2" Style="{StaticResource FormLabel}"/>
                                <ComboBox x:Name="CbEq2" Style="{StaticResource ModernComboBox}"
                                          DisplayMemberPath="Nom"
                                          SelectionChanged="Equipe_SelectionChanged"/>
                                <Border x:Name="PanelEq2" Background="{StaticResource CardBrush}"
                                        CornerRadius="6" Margin="0,10,0,0" Padding="12"
                                        Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock x:Name="TbEq2Score"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   FontWeight="Bold" FontSize="13" Margin="0,0,0,6"/>
                                        <DataGrid x:Name="GridEq2" MaxHeight="140"
                                                  Background="Transparent" RowBackground="Transparent"
                                                  AlternatingRowBackground="#1A2332">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Nom"   Binding="{Binding Nom}"          Width="*"/>
                                                <DataGridTextColumn Header="Poste" Binding="{Binding Affectation}"  Width="110"/>
                                                <DataGridTextColumn Header="Score" Binding="{Binding ScoreGeneral}" Width="60"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- ── Probabilités de victoire ── -->
                        <Border x:Name="PanelProba"
                                Background="{StaticResource CardBrush}"
                                CornerRadius="6" Margin="0,12,0,0" Padding="16,12"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <TextBlock x:Name="TbProba1NomEquipe"
                                               FontSize="11" FontWeight="Bold"
                                               Foreground="{StaticResource MutedBrush}"
                                               HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="TbProba1"
                                               FontSize="30" FontWeight="Black"
                                               Foreground="{StaticResource AccentBrush}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="de chances de gagner"
                                               FontSize="11" Foreground="{StaticResource MutedBrush}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="VS"
                                           FontSize="20" FontWeight="Black"
                                           Foreground="{StaticResource DangerBrush}"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                           Margin="20,0"/>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <TextBlock x:Name="TbProba2NomEquipe"
                                               FontSize="11" FontWeight="Bold"
                                               Foreground="{StaticResource MutedBrush}"
                                               HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="TbProba2"
                                               FontSize="30" FontWeight="Black"
                                               Foreground="{StaticResource AccentBrush}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="de chances de gagner"
                                               FontSize="11" Foreground="{StaticResource MutedBrush}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- ── Avertissement joueurs en commun ── -->
                        <Border x:Name="PanelAvertissement"
                                Background="#3D0000" CornerRadius="6"
                                Margin="0,10,0,0" Padding="14,10"
                                Visibility="Collapsed">
                            <TextBlock x:Name="TbAvertissement"
                                       Foreground="#FF6B6B" FontWeight="Bold" FontSize="13"
                                       TextWrapping="Wrap" HorizontalAlignment="Center"/>
                        </Border>

                        <!-- ── Sélecteur de mode : simulation auto OU saisie manuelle du score ── -->
                        <Border Background="{StaticResource CardBrush}" CornerRadius="6"
                                Margin="0,16,0,0" Padding="10">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <!-- Actif par défaut (BtnPrimary), passe en BtnSecondary quand inactif -->
                                <Button x:Name="BtnModeSimulation"
                                        Content="Simulation automatique"
                                        Style="{StaticResource BtnPrimary}"
                                        Padding="20,8" Margin="0,0,8,0"
                                        Click="ModeSimulation_Click"/>
                                <Button x:Name="BtnModeSaisie"
                                        Content="Saisie manuelle du score"
                                        Style="{StaticResource BtnSecondary}"
                                        Padding="20,8"
                                        Click="ModeSaisie_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- ── Bouton simuler (mode simulation) ── -->
                        <Button x:Name="BtnSimuler"
                                Content="SIMULER LE MATCH"
                                Style="{StaticResource BtnDanger}"
                                HorizontalAlignment="Center" Margin="0,16"
                                Padding="30,12" FontSize="15"
                                IsEnabled="False"
                                Click="Simuler_Click"/>

                        <!-- ── Saisie manuelle (mode manuel) ── -->
                        <Border x:Name="PanelSaisieManuelle" Visibility="Collapsed"
                                Background="{StaticResource CardBrush}"
                                CornerRadius="8" Padding="24" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="SAISIE DU SCORE" Style="{StaticResource FormLabel}"
                                           Margin="0,0,0,16"/>
                                <Grid HorizontalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="180"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TbManuelNom1" Grid.Column="0"
                                               Text="Équipe 1" FontSize="15" FontWeight="Bold"
                                               Foreground="White" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" TextWrapping="Wrap"
                                               TextAlignment="Center"/>
                                    <TextBox x:Name="TbScoreManuel1" Grid.Column="1"
                                             Style="{StaticResource ModernTextBox}"
                                             FontSize="24" FontWeight="Black"
                                             TextAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="—" FontSize="28" FontWeight="Black"
                                               Foreground="{StaticResource MutedBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TbScoreManuel2" Grid.Column="3"
                                             Style="{StaticResource ModernTextBox}"
                                             FontSize="24" FontWeight="Black"
                                             TextAlignment="Center"/>
                                    <TextBlock x:Name="TbManuelNom2" Grid.Column="4"
                                               Text="Équipe 2" FontSize="15" FontWeight="Bold"
                                               Foreground="White" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" TextWrapping="Wrap"
                                               TextAlignment="Center"/>
                                </Grid>
                                <Button Content="Enregistrer le score"
                                        Style="{StaticResource BtnSuccess}"
                                        HorizontalAlignment="Center" Margin="0,20,0,0"
                                        Padding="24,10" Click="SauverManuel_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- ── Résultats simulation ── -->
                        <Border x:Name="PanelResultats"
                                Background="{StaticResource CardBrush}"
                                CornerRadius="8" Padding="20"
                                Visibility="Collapsed" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock x:Name="TbVainqueur"
                                           FontSize="14" Foreground="{StaticResource MutedBrush}"
                                           HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                <TextBlock x:Name="TbScoreFinal"
                                           FontSize="42" FontWeight="Black" Foreground="White"
                                           HorizontalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center" Margin="0,8,0,16">
                                    <TextBlock x:Name="TbMT1"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="13" Margin="0,0,20,0"/>
                                    <TextBlock x:Name="TbMT2"
                                               Foreground="{StaticResource MutedBrush}" FontSize="13"/>
                                </StackPanel>
                                <TextBlock Text="BUTEURS" Style="{StaticResource FormLabel}"
                                           Margin="0,0,0,8"/>
                                <TextBox x:Name="TbButeurs" IsReadOnly="True" TextWrapping="Wrap"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{StaticResource TextBrush}" FontSize="13"/>
                                <TextBlock x:Name="LblBlessuresHeader" Text="BLESSURES"
                                           Style="{StaticResource FormLabel}"
                                           Margin="0,14,0,8" Visibility="Collapsed"/>
                                <TextBox x:Name="TbBlessures" IsReadOnly="True" TextWrapping="Wrap"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="#E74C3C" FontSize="13"
                                         Visibility="Collapsed"/>
                                <Button x:Name="BtnSauver"
                                        Content="Enregistrer le match"
                                        Style="{StaticResource BtnSuccess}"
                                        HorizontalAlignment="Right" Margin="0,12,0,0"
                                        Click="Sauver_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- ── Evaluation des joueurs (affiché après sauvegarde du match) ── -->
                        <Border x:Name="PanelEvaluation"
                                Background="{StaticResource CardBrush}"
                                CornerRadius="8" Padding="20"
                                Visibility="Collapsed" Margin="0,8,0,20">
                            <StackPanel>
                                <TextBlock Text="EVALUATION DES JOUEURS"
                                           Style="{StaticResource FormLabel}" Margin="0,0,0,6"/>
                                <TextBlock Text="Notez la performance de chaque joueur pour faire évoluer leurs compétences."
                                           Foreground="{StaticResource MutedBrush}" FontSize="12"
                                           TextWrapping="Wrap" Margin="0,0,0,14"/>
                                <DataGrid x:Name="GridEval" AutoGenerateColumns="False"
                                          CanUserAddRows="False" CanUserDeleteRows="False"
                                          IsReadOnly="False"
                                          MaxHeight="340"
                                          Background="Transparent" RowBackground="Transparent"
                                          AlternatingRowBackground="#1A2332">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Joueur" Binding="{Binding Nom}"
                                                            Width="*" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Equipe" Binding="{Binding NomEquipe}"
                                                            Width="160" IsReadOnly="True"/>
                                        <!-- DataGridTemplateColumn utilisé car une colonne TextColumn ne supporte pas les ComboBox -->
                                        <DataGridTemplateColumn Header="Performance" Width="160">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <!-- TwoWay + UpdateSourceTrigger=PropertyChanged : la Note est mise à jour dès la sélection -->
                                                    <ComboBox ItemsSource="{StaticResource Notes}"
                                                              SelectedItem="{Binding Note, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              Style="{StaticResource ModernComboBox}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Button Content="Valider l'evaluation"
                                        Style="{StaticResource BtnSuccess}"
                                        HorizontalAlignment="Right" Margin="0,14,0,0"
                                        Click="ValiderEval_Click"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ══════════════ ONGLET HISTORIQUE ══════════════ -->
            <TabItem Header="  Historique  " Foreground="{StaticResource TextBrush}"
                     Background="{StaticResource CardBrush}"
                     GotFocus="HistoriqueTab_GotFocus">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="GridHistorique" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date"      Binding="{Binding DateDisplay}"  Width="140"/>
                            <DataGridTextColumn Header="Équipe 1"  Binding="{Binding NomEquipe1}"   Width="*"/>
                            <DataGridTextColumn Header="Score"     Binding="{Binding Resultat}"     Width="80"/>
                            <DataGridTextColumn Header="Équipe 2"  Binding="{Binding NomEquipe2}"   Width="*"/>
                            <DataGridTextColumn Header="Vainqueur" Binding="{Binding Vainqueur}"    Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button Grid.Row="1" Content="Actualiser"
                            Style="{StaticResource BtnSecondary}"
                            HorizontalAlignment="Right" Margin="0,10,0,0"
                            Click="ActualiserHisto_Click"/>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- FOOTER -->
        <Border Grid.Row="2" Background="#0E0826"
                BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,1,0,0">
            <Button Content="←  Retour" Style="{StaticResource BtnSecondary}"
                    HorizontalAlignment="Right" Margin="0,0,16,0"
                    Click="Retour_Click"/>
        </Border>
    </Grid>
</UserControl>
